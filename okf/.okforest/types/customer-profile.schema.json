{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer Profile",
  "description": "A kind of customer the company serves well, and how to recognize one.",
  "type": "object",
  "properties": {
    "x-industries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The industries they work in."
    },
    "x-company-size": {
      "type": "string",
      "description": "How big they are, like 50 to 500 employees."
    },
    "x-regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Where they are."
    },
    "x-buyer": {
      "type": "string",
      "description": "The role of the person who buys, like Head of Operations."
    }
  },
  "propertyNames": {
    "not": {
      "pattern": "(password|passwd|secret|token|api[_-]?key|private[_-]?key|account[_-]?number|routing)"
    }
  }
}
