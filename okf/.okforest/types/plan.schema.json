{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "description": "Work the company intends to do over a period: a roadmap, a strategy, a campaign.",
  "type": "object",
  "required": [
    "x-owner"
  ],
  "properties": {
    "x-owner": {
      "$ref": "#/$defs/role",
      "description": "The role responsible for keeping this page true."
    },
    "x-period": {
      "$ref": "#/$defs/period",
      "description": "The period the plan covers."
    },
    "x-state": {
      "enum": [
        "proposed",
        "active",
        "done",
        "dropped"
      ],
      "description": "Where the plan stands."
    }
  },
  "propertyNames": {
    "not": {
      "pattern": "(password|passwd|secret|token|api[_-]?key|private[_-]?key|account[_-]?number|routing)"
    }
  },
  "$defs": {
    "role": {
      "type": "string",
      "pattern": "^/people/roles/[a-z0-9-]+(\\.md)?$",
      "description": "A Role page, e.g. /people/roles/cfo."
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}(-(Q[1-4]|H[12]|\\d{2}))?$",
      "description": "A year (2027), half (2027-H1), quarter (2027-Q1), or month (2027-01)."
    }
  }
}
