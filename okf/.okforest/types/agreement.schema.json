{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agreement",
  "description": "A contract or legal document: who it's with, its key terms, and where the signed copy is kept.",
  "type": "object",
  "required": [
    "owner",
    "kind"
  ],
  "properties": {
    "owner": {
      "$ref": "#/$defs/role",
      "description": "The role responsible for keeping this page true."
    },
    "kind": {
      "enum": [
        "terms-of-service",
        "privacy-policy",
        "dpa",
        "nda",
        "msa",
        "order-form",
        "other"
      ],
      "description": "What kind of agreement it is."
    },
    "counterparty": {
      "type": "string",
      "description": "Who it's with, or 'customers' for a standard agreement."
    },
    "effective": {
      "$ref": "#/$defs/date",
      "description": "When it took effect."
    },
    "expires": {
      "$ref": "#/$defs/date",
      "description": "When it ends or renews."
    }
  },
  "propertyNames": {
    "not": {
      "pattern": "(password|passwd|secret|token|api[_-]?key|private[_-]?key|account[_-]?number|routing)"
    }
  },
  "$defs": {
    "role": {
      "type": "string",
      "pattern": "^/people/roles/[a-z0-9-]+(\\.md)?$",
      "description": "A Role page, e.g. /people/roles/cfo."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "A date: YYYY-MM-DD."
    }
  }
}
