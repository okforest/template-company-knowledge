{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Budget",
  "description": "What the company plans to spend over a period, by area, and who approved it.",
  "type": "object",
  "required": [
    "owner",
    "period",
    "currency"
  ],
  "properties": {
    "owner": {
      "$ref": "#/$defs/role",
      "description": "The role responsible for keeping this page true."
    },
    "period": {
      "$ref": "#/$defs/period",
      "description": "The period the budget covers."
    },
    "currency": {
      "$ref": "#/$defs/currency",
      "description": "The currency of the amounts."
    },
    "state": {
      "enum": [
        "proposed",
        "approved"
      ],
      "description": "Whether it has been approved."
    },
    "approved_by": {
      "$ref": "#/$defs/role",
      "description": "The role that approved it."
    }
  },
  "propertyNames": {
    "not": {
      "pattern": "(password|passwd|secret|token|api[_-]?key|private[_-]?key|account[_-]?number|routing)"
    }
  },
  "$defs": {
    "role": {
      "type": "string",
      "pattern": "^/people/roles/[a-z0-9-]+(\\.md)?$",
      "description": "A Role page, e.g. /people/roles/cfo."
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}(-(Q[1-4]|H[12]|\\d{2}))?$",
      "description": "A year (2027), half (2027-H1), quarter (2027-Q1), or month (2027-01)."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "An ISO 4217 currency code, e.g. USD."
    }
  }
}
