{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Statement",
  "description": "Exact wording the company has agreed on, such as its mission or boilerplate. Quote it verbatim; don't paraphrase it.",
  "type": "object",
  "required": [
    "owner"
  ],
  "properties": {
    "owner": {
      "$ref": "#/$defs/role",
      "description": "The role responsible for keeping this page true."
    },
    "adopted": {
      "$ref": "#/$defs/date",
      "description": "When this wording was agreed."
    }
  },
  "propertyNames": {
    "not": {
      "pattern": "(password|passwd|secret|token|api[_-]?key|private[_-]?key|account[_-]?number|routing)"
    }
  },
  "$defs": {
    "role": {
      "type": "string",
      "pattern": "^/people/roles/[a-z0-9-]+(\\.md)?$",
      "description": "A Role page, e.g. /people/roles/cfo."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "A date: YYYY-MM-DD."
    }
  }
}
